---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import { SITE } from "@/config";

const certifications = await getCollection(
  "certifications",
  ({ data }) => !data.draft
);

const sortedCerts = certifications.sort(
  (a, b) => b.data.dateEarned.getTime() - a.data.dateEarned.getTime()
);

const activeCerts = sortedCerts.filter(
  c => !c.data.expiryDate || c.data.expiryDate > new Date()
);
const expiredCerts = sortedCerts.filter(
  c => c.data.expiryDate && c.data.expiryDate <= new Date()
);
---

<Layout title={`Certifications | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Certifications"
    pageDesc="Professional certifications and credentials I've earned."
  >
    {
      sortedCerts.length === 0 ? (
        <p class="italic opacity-70">No certifications listed yet.</p>
      ) : (
        <div class="space-y-10">
          {/* Active Certifications */}
          {activeCerts.length > 0 && (
            <div>
              <h2 class="mb-4 text-xl font-bold">
                Active
                <sup class="ml-1 text-sm font-normal opacity-70">
                  {activeCerts.length}
                </sup>
              </h2>
              <div class="grid gap-4 sm:grid-cols-2">
                {activeCerts.map(cert => (
                  <a
                    href={cert.data.credentialUrl || "#"}
                    target={cert.data.credentialUrl ? "_blank" : undefined}
                    rel={cert.data.credentialUrl ? "noopener noreferrer" : undefined}
                    class="group flex flex-col items-center rounded-lg border border-border p-6 text-center transition-colors hover:border-accent/50 no-underline"
                  >
                    {cert.data.badgeUrl && (
                      <img
                        src={cert.data.badgeUrl}
                        alt={cert.data.name}
                        class="mb-4 h-24 w-24 object-contain"
                      />
                    )}
                    <h3 class="text-lg font-semibold group-hover:text-accent">
                      {cert.data.name}
                    </h3>
                    <p class="mt-1 text-sm opacity-70">{cert.data.issuer}</p>
                    <p class="mt-2 text-sm opacity-80">{cert.data.description}</p>
                    {cert.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap justify-center gap-1.5">
                        {cert.data.tags.map(tag => (
                          <span class="rounded-full border border-border px-2 py-0.5 text-xs opacity-70">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                    {cert.data.credentialUrl && (
                      <span class="mt-3 text-sm text-accent underline underline-offset-4">
                        Verify credential →
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* Expired Certifications */}
          {expiredCerts.length > 0 && (
            <div>
              <h2 class="mb-4 text-xl font-bold opacity-60">
                Expired
                <sup class="ml-1 text-sm font-normal opacity-70">
                  {expiredCerts.length}
                </sup>
              </h2>
              <div class="grid gap-4 opacity-60 sm:grid-cols-2">
                {expiredCerts.map(cert => (
                  <div class="rounded-lg border border-border p-5">
                    <div class="mb-3 flex items-start justify-between gap-2">
                      <div>
                        <h3 class="text-lg font-semibold">{cert.data.name}</h3>
                        <p class="text-sm opacity-70">{cert.data.issuer}</p>
                      </div>
                      <span class="shrink-0 rounded-full bg-yellow-500/15 px-2.5 py-0.5 text-xs font-medium text-yellow-600 dark:text-yellow-400">
                        Expired
                      </span>
                    </div>
                    <p class="mb-3 text-sm opacity-80">{cert.data.description}</p>
                    <div class="flex flex-wrap items-center gap-3 text-xs opacity-60">
                      <span>
                        Earned:{" "}
                        {cert.data.dateEarned.toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                        })}
                      </span>
                      {cert.data.expiryDate && (
                        <span>
                          Expired:{" "}
                          {cert.data.expiryDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                          })}
                        </span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>
