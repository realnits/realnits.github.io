---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

const myProjects = [
  {
    name: "Agamotto",
    description: "AI-driven CLI framework that uses advanced vision models to analyze architectures and predict future threats before they manifest.",
    url: "https://github.com/realnits/Agamotto",
    language: "Go",
    tags: ["aws", "ai", "threat-modeling", "devsecops", "security-engineering"],
    featured: true,
  },
  {
    name: "ansiblesec",
    description: "Security automation tooling built with Rust for infrastructure hardening and compliance checks.",
    url: "https://github.com/realnits/ansiblesec",
    language: "Rust",
    tags: ["automation", "security", "infrastructure"],
    featured: true,
  },
  {
    name: "shellthreatmodel",
    description: "Shell-based threat modeling tool for quick security assessments from the command line.",
    url: "https://github.com/realnits/shellthreatmodel",
    language: "Python",
    tags: ["threat-modeling", "cli"],
    featured: true,
    archived: true,
  },
  {
    name: "realnits.github.io",
    description: "This blog — built with Astro and the AstroPaper theme. Security writeups, CVEs, and learning notes.",
    url: "https://github.com/realnits/realnits.github.io",
    language: "Astro",
    tags: ["blog", "astro"],
    featured: false,
  },
];

const contributions = [
  {
    name: "dalfox",
    description: "Powerful open-source XSS scanner and utility focused on automation.",
    url: "https://github.com/hahwul/dalfox",
    forkUrl: "https://github.com/realnits/dalfox",
    language: "Go",
    author: "hahwul",
  },
  {
    name: "subfinder",
    description: "Fast passive subdomain enumeration tool.",
    url: "https://github.com/projectdiscovery/subfinder",
    forkUrl: "https://github.com/realnits/subfinder",
    language: "Go",
    author: "projectdiscovery",
  },
  {
    name: "slv",
    description: "Securely store, share, and access secrets alongside the codebase.",
    url: "https://github.com/amagioss/slv",
    forkUrl: "https://github.com/realnits/slv",
    language: "Go",
    author: "amagioss",
  },
  {
    name: "cloudfront-prefix-list-bypass",
    description: "Research tool for CloudFront prefix list bypass techniques.",
    url: "https://github.com/f-lucini/cloudfront-prefix-list-bypass",
    forkUrl: "https://github.com/realnits/cloudfront-prefix-list-bypass",
    language: "Python",
    author: "f-lucini",
  },
  {
    name: "bugbounty-disclosed-reports",
    description: "Public disclosed bug bounty reports formatted in markdown.",
    url: "https://github.com/marcotuliocnd/bugbounty-disclosed-reports",
    forkUrl: "https://github.com/realnits/bugbounty-disclosed-reports",
    language: "Markdown",
    author: "marcotuliocnd",
  },
];

const langColors: Record<string, string> = {
  Go: "bg-sky-400",
  Python: "bg-blue-500",
  Rust: "bg-orange-500",
  Astro: "bg-purple-500",
  Markdown: "bg-gray-400",
};

const featured = myProjects.filter(p => p.featured);
const other = myProjects.filter(p => !p.featured);
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">

    <h1 class="text-2xl font-bold sm:text-3xl">Projects</h1>
    <p class="mt-2 mb-8 opacity-70">Things I've built and open source projects I contribute to.</p>

    <!-- My Projects -->
    <section class="mb-12">
      <h2 class="mb-4 text-lg font-bold text-accent">My Projects</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {featured.map(project => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col rounded-xl border-2 border-border bg-muted/20 p-5 no-underline transition-all hover:-translate-y-0.5 hover:border-accent/50"
          >
            {project.archived && (
              <span class="absolute top-3 right-3 rounded-full bg-muted px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide opacity-60">
                archived
              </span>
            )}
            <div class="mb-2 flex items-center gap-2">
              <svg class="h-5 w-5 shrink-0 opacity-60" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
              </svg>
              <span class="font-bold group-hover:text-accent transition-colors">{project.name}</span>
            </div>
            <p class="mb-3 flex-1 text-sm leading-relaxed opacity-70">{project.description}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flex items-center gap-1 text-xs opacity-60">
                <span class={`inline-block h-2.5 w-2.5 rounded-full ${langColors[project.language] || "bg-gray-400"}`}></span>
                {project.language}
              </span>
              {project.tags.slice(0, 3).map(tag => (
                <span class="rounded-full bg-muted/60 px-2 py-0.5 text-[0.65rem] opacity-60">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>

      {other.length > 0 && (
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {other.map(project => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 rounded-lg border border-border p-4 no-underline transition-all hover:border-accent/40"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0 opacity-50" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
              </svg>
              <div class="min-w-0">
                <span class="text-sm font-semibold group-hover:text-accent transition-colors">{project.name}</span>
                <p class="mt-0.5 text-xs opacity-60">{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Contributions -->
    <section>
      <h2 class="mb-4 text-lg font-bold text-accent">Open Source Contributions</h2>
      <div class="divide-y divide-border rounded-xl border border-border">
        {contributions.map(contrib => (
          <a
            href={contrib.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start gap-3 p-4 no-underline transition-colors hover:bg-muted/20 first:rounded-t-xl last:rounded-b-xl"
          >
            <svg class="mt-1 h-4 w-4 shrink-0 opacity-40" viewBox="0 0 16 16" fill="currentColor">
              <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
            </svg>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-sm font-bold group-hover:text-accent transition-colors">{contrib.name}</span>
                <span class="text-xs opacity-40">by {contrib.author}</span>
              </div>
              <p class="mt-0.5 text-xs leading-relaxed opacity-60">{contrib.description}</p>
            </div>
            <span class="flex shrink-0 items-center gap-1 text-xs opacity-50">
              <span class={`inline-block h-2 w-2 rounded-full ${langColors[contrib.language] || "bg-gray-400"}`}></span>
              {contrib.language}
            </span>
          </a>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</Layout>
